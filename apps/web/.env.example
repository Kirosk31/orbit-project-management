# Orbit web environment variables
# Copy to .env for local overrides. Only VITE_-prefixed variables are
# inlined into the client bundle at build time.

# Base URL of the Orbit API. Defaults to the same-origin path served by the
# Vite dev proxy (development) or NGINX (production).
VITE_API_URL=/api/v1

# Public application name shown in the UI shell.
VITE_APP_NAME=Orbit
