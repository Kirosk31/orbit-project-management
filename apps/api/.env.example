# Orbit API environment configuration
# Copy to .env and adjust for your local environment.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL connection string
DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit?schema=public

# Redis connection string
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Local storage root for file uploads
UPLOAD_DIR=./data/uploads

# SMTP (leave SMTP_HOST empty in development to use the console transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Orbit <no-reply@orbit.local>

# Rate limiting (points per window per IP)
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_RECOVERY_MAX=5
RATE_LIMIT_APPLICATION_WINDOW_SECONDS=60
RATE_LIMIT_INVITATION_MAX=20
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_ANALYTICS_MAX=30

# Forwarded client IP trust. Keep false for direct/local traffic. Behind the
# provided reverse proxy use: loopback,linklocal,uniquelocal
TRUST_PROXY=false

# Interactive OpenAPI documentation should normally be disabled in production.
EXPOSE_API_DOCS=true

# Authentication
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Web app origin used in email links
WEB_APP_URL=http://localhost:5173

# Optional local sample data. Keep disabled outside disposable development databases.
SEED_SAMPLE_DATA=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
