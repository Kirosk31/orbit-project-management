{
  "name": "@orbit/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts between Orbit API and web: enums, permission keys, DTO schemas, API types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orbit/tsconfig": "*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
