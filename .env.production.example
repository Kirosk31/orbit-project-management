# Copy this file to .env.production and replace every REQUIRED value.
# Never commit .env.production.

# Public URL where the NGINX container is reachable. Use HTTPS in production.
APP_URL=https://orbit.example.com
WEB_PORT=8080

# PostgreSQL. Use a unique, randomly generated password without URL-reserved characters,
# or percent-encode it in DATABASE_URL.
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=REQUIRED_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://orbit:REQUIRED_RANDOM_DATABASE_PASSWORD@postgres:5432/orbit?schema=public

# Redis is private to the Compose network and additionally requires authentication.
REDIS_PASSWORD=REQUIRED_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REQUIRED_RANDOM_REDIS_PASSWORD@redis:6379

# Generate at least 48 random bytes. Example command:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REQUIRED_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS

# Generate exactly 32 random bytes. Keep this key separate from JWT_ACCESS_SECRET.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OUTBOX_ENCRYPTION_KEY=REQUIRED_RANDOM_32_BYTE_BASE64URL_KEY

# Transactional email is required for public account recovery and invitations.
SMTP_HOST=REQUIRED_SMTP_HOST
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Orbit <no-reply@example.com>

LOG_LEVEL=info
